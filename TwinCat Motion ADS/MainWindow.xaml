<Window x:Class="TwinCat_Motion_ADS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:local="clr-namespace:TwinCat_Motion_ADS"
        mc:Ignorable="d"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="S.M.A.C.K" Icon="ImageAssets/ibexHead.jpg"
        WindowState="Normal" WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Name="myMainWindow" Width="1120" Height="760" MinWidth="780" MinHeight="570"
        Background="{StaticResource Smack.Bg}"
        Closing="Window_Closing">

    <Grid x:Name="mainWindowGrid" Focusable="True" Background="{StaticResource Smack.Bg}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= Sidebar ================= -->
        <Border Background="{StaticResource Smack.Surface}" BorderBrush="{StaticResource Smack.Border}" BorderThickness="0,0,1,0">
            <DockPanel Margin="9,14,9,10" LastChildFill="False">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="10,0,0,8">
                        <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{StaticResource Smack.Accent}" VerticalAlignment="Center"/>
                        <TextBlock Text="S.M.A.C.K" FontSize="16" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="MOTION" Style="{StaticResource NavHeader}"/>
                    <RadioButton x:Name="NcAxis" Content="NC axis" Tag="&#xE713;" GroupName="pages" IsChecked="True" Style="{StaticResource NavItem}" Click="RadioButton_Click"/>
                    <RadioButton x:Name="AirAxis" Content="Air axis" Tag="&#xE7BC;" GroupName="pages" Style="{StaticResource NavItem}" Click="RadioButton_Click"/>

                    <TextBlock Text="TOOLS" Style="{StaticResource NavHeader}"/>
                    <Button x:Name="DevicesButton" Content="Devices" Tag="&#xE770;" Style="{StaticResource NavButton}" Click="MeasureDevicesMenu_Click">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="MeasureDevicesMenu" Placement="Right">
                                <MenuItem Header="Add new device..." Click="AddNewDevice"/>
                                <MenuItem Header="Import devices..." Click="ImportDevices_Click"/>
                                <MenuItem Header="Export devices..." Click="ExportDevices_Click"/>
                                <Separator/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <RadioButton x:Name="CsvHelper" Content="CSV helper" Tag="&#xE9D9;" GroupName="pages" Style="{StaticResource NavItem}" Click="RadioButton_Click"/>
                    <Button x:Name="TestSuiteMenu" Content="Test suite" Tag="&#xE9D5;" Style="{StaticResource NavButton}" Click="TestSuiteMenu_Click"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <RadioButton x:Name="SettingsScreen" Content="Settings" Tag="&#xE713;" GroupName="pages" Style="{StaticResource NavItem}" Click="RadioButton_Click"/>
                    <Button x:Name="HelpMenu" Content="Help" Tag="&#xE897;" Style="{StaticResource NavButton}" Click="HelpMenu_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================= Content ================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header: page title + PLC status -->
            <Grid Margin="16,12,16,5">
                <TextBlock Text="{Binding PageTitle}" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Border HorizontalAlignment="Right" CornerRadius="12" Padding="10,4">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource Smack.DangerSoft}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPlcConnected}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource Smack.OkSoft}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource Smack.Danger}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPlcConnected}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource Smack.Ok}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock FontSize="12.5" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="PLC not connected"/>
                                    <Setter Property="Foreground" Value="{StaticResource Smack.Danger}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPlcConnected}" Value="True">
                                            <Setter Property="Text" Value="{Binding AmsNetID, StringFormat='PLC connected · {0}:852'}"/>
                                            <Setter Property="Foreground" Value="{StaticResource Smack.Ok}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Page host -->
            <ContentControl x:Name="tabbedWindow" Grid.Row="1" Margin="16,3,16,8"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>

            <!-- Console -->
            <Border Grid.Row="2" Margin="16,0,16,12" Height="202" CornerRadius="10" Background="{StaticResource Smack.Console}">
                <Grid>
                    <ListBox x:Name="consoleListBox" local:ListBoxBehavior.ScrollOnNewItem="True"
                             Style="{StaticResource ConsoleListBox}" ItemTemplate="{StaticResource ConsoleItemTemplate}"/>
                    <Button x:Name="clearScreenButton2" Content="Clear" Click="clearScreenButton_Click"
                            Style="{StaticResource ConsoleClearButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,18,0"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
