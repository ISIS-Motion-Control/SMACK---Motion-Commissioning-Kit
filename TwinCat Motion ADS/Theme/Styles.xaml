<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:primitives="clr-namespace:ModernWpf.Controls.Primitives;assembly=ModernWpf">


    <!-- ===== Palette ===== -->
    <SolidColorBrush x:Key="Smack.Bg" Color="#F6F7F5"/>
    <SolidColorBrush x:Key="Smack.Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Smack.Border" Color="#E1E4DF"/>
    <SolidColorBrush x:Key="Smack.Hover" Color="#EFF1ED"/>
    <SolidColorBrush x:Key="Smack.Text" Color="#1F2328"/>
    <SolidColorBrush x:Key="Smack.TextMuted" Color="#6B7078"/>
    <SolidColorBrush x:Key="Smack.Accent" Color="#2563C9"/>
    <SolidColorBrush x:Key="Smack.AccentHover" Color="#1D50A6"/>
    <SolidColorBrush x:Key="Smack.AccentSoft" Color="#E4EEFC"/>
    <SolidColorBrush x:Key="Smack.Danger" Color="#B42318"/>
    <SolidColorBrush x:Key="Smack.DangerSoft" Color="#FCE8E6"/>
    <SolidColorBrush x:Key="Smack.Ok" Color="#1B6B2F"/>
    <SolidColorBrush x:Key="Smack.OkSoft" Color="#D7F0DB"/>
    <SolidColorBrush x:Key="Smack.ChipOff" Color="#ECEEEA"/>
    <SolidColorBrush x:Key="Smack.SelectedNeutral" Color="#ECEFEC"/>
    <SolidColorBrush x:Key="Smack.FocusNeutral" Color="#A7ACA7"/>
    <SolidColorBrush x:Key="Smack.Console" Color="#1C1D1F"/>
    <FontFamily x:Key="Smack.Mono">Cascadia Mono, Consolas</FontFamily>

    <!-- ===== Shared forms ===== -->
    <Style x:Key="SmackTextBox"
       TargetType="TextBox"
       BasedOn="{StaticResource {x:Type TextBox}}">

        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Padding" Value="9,5"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>

        <Setter Property="Background"
            Value="{StaticResource Smack.Surface}"/>
        <Setter Property="BorderBrush"
            Value="{StaticResource Smack.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>

        <Setter Property="SelectionBrush"
            Value="{StaticResource Smack.FocusNeutral}"/>
        <Setter Property="CaretBrush"
            Value="{StaticResource Smack.Text}"/>

        <Setter Property="primitives:ControlHelper.CornerRadius"
            Value="7"/>
    </Style>
    <Style x:Key="CompactFormLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="{StaticResource Smack.TextMuted}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="Margin" Value="0,0,0,3"/>
    </Style>

    <Style x:Key="SmackComboBox"
       TargetType="ComboBox"
       BasedOn="{StaticResource {x:Type ComboBox}}">

        <Style.Resources>
            <!-- Background -->
            <SolidColorBrush x:Key="ComboBoxBackground"
                         Color="White"/>
            <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver"
                         Color="White"/>
            <SolidColorBrush x:Key="ComboBoxBackgroundPressed"
                         Color="White"/>
            <SolidColorBrush x:Key="ComboBoxBackgroundFocused"
                         Color="White"/>
            <SolidColorBrush x:Key="ComboBoxBackgroundUnfocused"
                         Color="White"/>

            <!-- Dropdown -->
            <SolidColorBrush x:Key="ComboBoxDropDownBackground"
                         Color="White"/>
        </Style.Resources>

        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="{StaticResource Smack.Text}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Smack.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="primitives:ControlHelper.CornerRadius" Value="7"/>
    </Style>
    
    <Style x:Key="SmackExpander" TargetType="Expander">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource Smack.TextMuted}"/>
        <Setter Property="Margin" Value="0,8,0,0"/>
    </Style>

    <!-- ===== Text ===== -->
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Smack.Text}"/>
    </Style>
    <Style x:Key="GroupTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Smack.TextMuted}"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
    <Style x:Key="MutedText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource Smack.TextMuted}"/>
    </Style>

    <Style x:Key="FormSection" TargetType="TextBlock" BasedOn="{StaticResource GroupTitle}">
        <Setter Property="Margin" Value="0,12,0,5"/>
    </Style>
    <!-- ===== Card ===== -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Smack.Surface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Smack.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

    <!-- ===== Buttons (Background is a TemplateBinding so SetFlashing still works) ===== -->
    <Style x:Key="SmackButton"
       TargetType="Button"
       BasedOn="{StaticResource {x:Type Button}}">

        <Setter Property="Background"
            Value="{StaticResource Smack.Surface}"/>
        <Setter Property="Foreground"
            Value="{StaticResource Smack.Text}"/>
        <Setter Property="BorderBrush"
            Value="{StaticResource Smack.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="primitives:ControlHelper.CornerRadius" Value="7"/>
    </Style>
    <Style x:Key="SmackPrimaryButton" TargetType="Button" BasedOn="{StaticResource SmackButton}">
        <Setter Property="Background" Value="{StaticResource Smack.Accent}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Smack.Accent}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Smack.AccentHover}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="SmackDangerButton" TargetType="Button" BasedOn="{StaticResource SmackButton}">
        <Setter Property="Foreground" Value="{StaticResource Smack.Danger}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Smack.DangerSoft}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="ConsoleClearButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Style.Resources>
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver"
                     Color="#2A2C2F"/>
            <SolidColorBrush x:Key="ButtonForegroundPointerOver"
                     Color="#9AA0A6"/>
            <SolidColorBrush x:Key="ButtonBackgroundPressed"
                 Color="#2A2C2F"/>
        </Style.Resources>
        <Setter Property="Background" Value="#2A2C2F"/>
        <Setter Property="Foreground" Value="#9AA0A6"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="10,3"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="primitives:ControlHelper.CornerRadius" Value="5"/>
    </Style>

    <!-- ===== Sidebar items ===== -->
    <Style x:Key="NavHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Smack.TextMuted}"/>
        <Setter Property="Margin" Value="10,16,0,4"/>
    </Style>
    <Style x:Key="NavItem" TargetType="RadioButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource Smack.Text}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="10,8" Margin="0,1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                       Width="24" VerticalAlignment="Center"/>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Smack.Hover}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{StaticResource Smack.SelectedNeutral}"/>
                <Setter Property="Foreground" Value="{StaticResource Smack.Text}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="NavButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource Smack.Text}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="10,8" Margin="0,1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                       Width="24" VerticalAlignment="Center"/>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Smack.Hover}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Status chips (CheckBox so existing IsChecked bindings keep working) ===== -->
    <Style x:Key="StatusChip" TargetType="CheckBox">
        <Setter Property="Background" Value="{StaticResource Smack.ChipOff}"/>
        <Setter Property="Foreground" Value="{StaticResource Smack.TextMuted}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border Background="{TemplateBinding Background}" CornerRadius="11" Padding="9,3">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{TemplateBinding Foreground}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{StaticResource Smack.OkSoft}"/>
                <Setter Property="Foreground" Value="{StaticResource Smack.Ok}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="ErrorChip" TargetType="CheckBox" BasedOn="{StaticResource StatusChip}">
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{StaticResource Smack.DangerSoft}"/>
                <Setter Property="Foreground" Value="{StaticResource Smack.Danger}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Console ===== -->
    <Style x:Key="ConsoleListItem" TargetType="ListBoxItem">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style x:Key="ConsoleListBox" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="FontFamily" Value="{StaticResource Smack.Mono}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <!-- Output is read-only: prevent selection instead of replacing the complete item template. -->
        <Setter Property="ItemContainerStyle" Value="{StaticResource ConsoleListItem}"/>
    </Style>
    <DataTemplate x:Key="ConsoleItemTemplate">
        <Grid Margin="0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="76"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding TimeShort}" Foreground="#7C8087"/>
            <TextBlock x:Name="msg" Grid.Column="1" Text="{Binding Message}" Foreground="#D6D8DB" TextWrapping="Wrap"/>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Level}" Value="Error">
                <Setter TargetName="msg" Property="Foreground" Value="#F08A84"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Level}" Value="Warning">
                <Setter TargetName="msg" Property="Foreground" Value="#E6C060"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Level}" Value="Success">
                <Setter TargetName="msg" Property="Foreground" Value="#7CC785"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
</ResourceDictionary>
