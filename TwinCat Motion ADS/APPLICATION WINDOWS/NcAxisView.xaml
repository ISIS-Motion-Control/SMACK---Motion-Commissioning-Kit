<UserControl x:Class="TwinCat_Motion_ADS.NcAxisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:TwinCat_Motion_ADS"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="980">
    <UserControl.Resources>
        <Style x:Key="SmackEnableButton" TargetType="Button" BasedOn="{StaticResource SmackButton}">
            <Setter Property="Content" Value="Enable"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, ElementName=enabledCheck}" Value="True">
                    <Setter Property="Content" Value="Disable"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <!-- Equal-width parameter columns shrink with the window; scroll only when minimum usable width is reached. -->
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <Grid x:Name="ncWindowGrid" MinWidth="650" Background="Transparent"
              Focusable="True" MouseDown="ncWindowGrid_MouseDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="315"/>
                <ColumnDefinition Width="*" MinWidth="325"/>
            </Grid.ColumnDefinitions>
            <!-- Axis control: controls directly retain the names and events used in NcAxisView.xaml.cs. -->
            <Border Grid.Column="0" Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel Grid.IsSharedSizeScope="True">
                    <Grid>
                        <TextBlock Text="Axis control" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <CheckBox x:Name="validAxis" Content="Linked" Style="{StaticResource StatusChip}"/>
                            <local:ReadbackControlMainWindow x:Name="currentAxisReadback" SetName="Axis" SetValue="0" BoxWidth="15"/>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <local:SettingControlMainWindow x:Name="AxisSelection" SetName="Axis" SetValue="1" BoxWidth="70"/>
                        <Button x:Name="initAxis" Grid.Column="1" Content="Init" Click="InitialiseAxis_Click"
                                Style="{StaticResource SmackButton}" Margin="8,3,0,3" MinWidth="65"/>
                    </Grid>
                    <local:ReadbackControlMainWindow x:Name="positionReadback" SetName="Position" SetValue="0" BoxWidth="90"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,6">
                        <CheckBox x:Name="enabledCheck" Content="Enabled" Style="{StaticResource StatusChip}"/>
                        <CheckBox x:Name="fwEnabledCheck" Content="Fw" Style="{StaticResource StatusChip}"/>
                        <CheckBox x:Name="bwEnabledCheck" Content="Bw" Style="{StaticResource StatusChip}"/>
                        <CheckBox x:Name="errorCheck" Content="Error" Style="{StaticResource ErrorChip}"/>
                    </StackPanel>
                    <local:SettingControlMainWindow x:Name="windowSetPoint" SetName="Setpoint" BoxWidth="100"/>
                    <local:SettingControlMainWindow x:Name="windowVelocity" SetName="Velocity" BoxWidth="100"/>
                    <UniformGrid Columns="2" Margin="0,8,0,0">
                        <Button x:Name="enableButton" Style="{StaticResource SmackEnableButton}" Click="AxisCommand_Click" Margin="0,0,4,6"/>
                        <Button x:Name="resetButton" Content="Reset" Style="{StaticResource SmackButton}" Click="AxisCommand_Click" Margin="4,0,0,6"/>
                        <Button x:Name="moveAbsButton" Content="Move abs" Style="{StaticResource SmackButton}" Click="AxisCommand_Click" Margin="0,0,4,6"/>
                        <Button x:Name="stopMove" Content="Stop" Style="{StaticResource SmackDangerButton}" Click="AxisCommand_Click" Margin="4,0,0,6"/>
                        <Button x:Name="moveRelButton" Content="Move rel" Style="{StaticResource SmackButton}" Click="AxisCommand_Click" Margin="0,0,4,6"/>
                        <Button x:Name="moveVelButton" Content="Move vel" Style="{StaticResource SmackButton}" Click="AxisCommand_Click" Margin="4,0,0,6"/>
                        <Button x:Name="move2High" Content="To high limit" Style="{StaticResource SmackButton}" Click="AxisCommand_Click" Margin="0,0,4,6"/>
                        <Button x:Name="move2Low" Content="To low limit" Style="{StaticResource SmackButton}" Click="AxisCommand_Click" Margin="4,0,0,6"/>
                    </UniformGrid>
                    <Button x:Name="homeButton" Content="Home axis" Style="{StaticResource SmackButton}" Click="AxisCommand_Click"/>
                    <!-- Limit reversal controls are always visible, not hidden behind an expander. -->
                    <UniformGrid Columns="2" Margin="0,6,0,0">
                        <Button x:Name="highLimReversal" Content="High reversal" ToolTip="High limit reversal"
                                Style="{StaticResource SmackButton}" Click="AxisCommand_Click" Margin="0,0,4,0"/>
                        <Button x:Name="lowLimReversal" Content="Low reversal" ToolTip="Low limit reversal"
                                Style="{StaticResource SmackButton}" Click="AxisCommand_Click" Margin="4,0,0,0"/>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- The common test settings and execution controls are immediately visible. -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="12,0,0,0" VerticalAlignment="Top">
                <StackPanel Grid.IsSharedSizeScope="True">
                    <TextBlock Text="Test parameters" Style="{StaticResource SectionTitle}"/>
                    <!-- Five compact rows, three equally sized columns. No minimum box width. -->
                    <UniformGrid Columns="3" Margin="0,6,0,1">
                        <local:SettingControlMainWindow x:Name="SettingTitle" SetName="Title" BoxWidth="0" Compact="True" BoxToolTip="Name for this test" SetValue="New test" Margin="0,0,6,0"/>
                        <local:SettingControlMainWindow x:Name="SettingTimeout" SetName="Timeout (s)" BoxWidth="0" Compact="True" BoxToolTip="Maximum time to wait for a move" Margin="0,0,6,0"/>
                        <local:SettingControlMainWindow x:Name="SettingVelocity" SetName="Velocity" BoxWidth="0" Compact="True" BoxToolTip="Axis velocity for this test" Margin="0"/>
                        <local:SettingControlMainWindow x:Name="SettingCycles" SetName="Cycles" BoxWidth="0" Compact="True" BoxToolTip="Number of test cycles" Margin="0,0,6,0"/>
                        <local:SettingControlMainWindow x:Name="SettingCycleDelay" SetName="Cycle delay (s)" BoxWidth="0" Compact="True" BoxToolTip="Wait between cycles" Margin="0,0,6,0"/>
                        <local:SettingControlMainWindow x:Name="SettingReversalVelocity" SetName="Reversal velocity" BoxWidth="0" Compact="True" BoxToolTip="Velocity when reversing off a limit" Margin="0"/>
                        <local:SettingControlMainWindow x:Name="SettingReversalExtraSeconds" SetName="Extra reversal (s)" BoxWidth="0" Compact="True" BoxToolTip="Additional reversal time" Margin="0,0,6,0"/>
                        <local:SettingControlMainWindow x:Name="SettingReversalSettlingSeconds" SetName="Reversal settle (s)" BoxWidth="0" Compact="True" BoxToolTip="Wait after contacting the limit" Margin="0,0,6,0"/>
                        <local:SettingControlMainWindow x:Name="SettingReversalDistance" SetName="Reversal distance" BoxWidth="0" Compact="True" BoxToolTip="Run-up distance for backlash" Margin="0"/>
                        <local:SettingControlMainWindow x:Name="SettingOvershootDistance" SetName="Overshoot distance" BoxWidth="0" Compact="True" BoxToolTip="Run-up distance at the return point" Margin="0,0,6,0"/>
                        <local:SettingControlMainWindow x:Name="SettingInitialSetpoint" SetName="Initial setpoint" BoxWidth="0" Compact="True" Margin="0,0,6,0"/>
                        <local:SettingControlMainWindow x:Name="SettingEndSetpoint" SetName="End setpoint" BoxWidth="0" Compact="True" Margin="0"/>
                        <local:SettingControlMainWindow x:Name="SettingAccuracySteps" SetName="Steps in test" BoxWidth="0" Compact="True" Margin="0,0,6,0"/>
                        <local:SettingControlMainWindow x:Name="SettingStepSize" SetName="Step size" BoxWidth="0" Compact="True" Margin="0,0,6,0"/>
                        <local:SettingControlMainWindow x:Name="SettingSettlingTime" SetName="Measure settle (s)" BoxWidth="0" Compact="True" Margin="0"/>
                    </UniformGrid>

                    <Border Height="1" Background="{StaticResource Smack.Border}" Margin="0,12,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="TestSelectionComboBox"
                            Style="{StaticResource SmackComboBox}"
                            SelectionChanged="TestSelectionComboBox_SelectionChanged"
                            ToolTip="More info about tests available in help"
                            PreviewKeyDown="TestSelectionComboBox_PreviewKeyDown"/>
                        <Button x:Name="RunSelectedTestButton" Grid.Column="1" Content="▶ Run" Click="RunSelectedTestButton_Click"
                                Style="{StaticResource SmackPrimaryButton}" MinWidth="82" Margin="6,0,0,0"/>
                    </Grid>
                    <!-- All four secondary test actions share a single responsive row. -->
                    <UniformGrid Columns="4" Margin="0,7,0,0">
                        <Button x:Name="pauseTest" Content="Pause" Click="PauseTest_Click" Style="{StaticResource SmackButton}" Margin="0,0,4,0" Padding="5,5"/>
                        <Button x:Name="cancelTest" Content="Cancel" Click="CancelTest_Click" Style="{StaticResource SmackButton}" Margin="0,0,4,0" Padding="5,5"/>
                        <Button x:Name="folderDirSelect" Content="Select" ToolTip="Select save directory" Click="SelectFolderDirectory_Click"
                                Style="{StaticResource SmackButton}" Margin="0,0,4,0" Padding="5,5"/>
                        <Button x:Name="testButton" Content="Import" ToolTip="Import test settings" Click="LoadSettingsFile_Click"
                                Style="{StaticResource SmackButton}" Padding="5,5"/>
                    </UniformGrid>
                    <WrapPanel Margin="0,8,0,0">
                        <CheckBox x:Name="testPausedCheck" Content="Paused" Style="{StaticResource StatusChip}"/>
                        <CheckBox x:Name="testCancelledCheck" Content="Cancelled" Style="{StaticResource ErrorChip}"/>
                    </WrapPanel>
                    <ProgressBar x:Name="testProgressBar" Minimum="0" Maximum="1" Height="5" Margin="0,6,0,4"
                                 Foreground="{StaticResource Smack.Accent}"/>
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Remaining " Style="{StaticResource MutedText}"/>
                            <TextBlock x:Name="EstimateTime" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="Est. end " Style="{StaticResource MutedText}"/>
                            <TextBlock x:Name="EstimateEndTime" FontSize="12"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
