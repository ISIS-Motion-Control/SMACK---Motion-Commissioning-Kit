<UserControl x:Class="TwinCat_Motion_ADS.SettingControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0,3">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="170"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="SettingTitle" Text="{Binding SetName}" VerticalAlignment="Center"
                   FontSize="13" Foreground="{StaticResource Smack.TextMuted}" Margin="0,0,10,0"/>
        <TextBox x:Name="SettingValue" Grid.Column="1" Text="{Binding SetValue}" Style="{StaticResource SmackTextBox}" TextAlignment="Right"/>
    </Grid>
</UserControl>
