<UserControl x:Class="TwinCat_Motion_ADS.ReadbackControlMainWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d">
    <Grid Margin="0,3">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" SharedSizeGroup="SettingLabel"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="SettingTitle" Grid.Column="0"
                   Text="{Binding SetName}"
                   MinWidth="{Binding TextWidth}"
                   Margin="0,0,16,0"
                   VerticalAlignment="Center"
                   FontSize="13"
                   Foreground="{StaticResource Smack.TextMuted}"/>
        <TextBlock x:Name="SettingValue" Grid.Column="1"
                   Text="{Binding SetValue, StringFormat=F3}"
                   MinWidth="{Binding BoxWidth}"
                   TextAlignment="Right"
                   VerticalAlignment="Center"
                   FontFamily="{StaticResource Smack.Mono}"
                   FontSize="18" FontWeight="SemiBold"
                   Foreground="{StaticResource Smack.Text}"/>
    </Grid>
</UserControl>
