<UserControl x:Class="TwinCat_Motion_ADS.AirAxisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="980">
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <Grid MinWidth="650">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.9*" MinWidth="295"/>
                <ColumnDefinition Width="1.1*" MinWidth="340"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Grid.Column="0" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Air axis control" Style="{StaticResource SectionTitle}"/>
                    <Button x:Name="initPneumatic" Content="Init air axis" Click="InitialisePneumatic_Click"
                            Style="{StaticResource SmackPrimaryButton}" Margin="0,10,0,6"/>
                    <Button x:Name="toggleAirOnBehaviour" Content="Invert air on logic" Click="toggleAirOnBehaviour_Click"
                            Style="{StaticResource SmackButton}"/>
                    <TextBlock Text="AXIS STATUS" Style="{StaticResource FormSection}"/>
                    <WrapPanel Margin="0,2,0,10">
                        <CheckBox x:Name="airOnLogic" Content="Air on to extend" Style="{StaticResource StatusChip}"/>
                        <CheckBox x:Name="CylinderAir" Content="Cylinder air" Style="{StaticResource StatusChip}"/>
                    </WrapPanel>
                    <TextBlock Text="LIMIT SWITCHES (NORMALLY CLOSED)" Style="{StaticResource GroupTitle}"/>
                    <WrapPanel Margin="0,2,0,12">
                        <CheckBox x:Name="pneumaticExtended" Content="Extended limit" Style="{StaticResource StatusChip}"/>
                        <CheckBox x:Name="pneumaticRetracted" Content="Retracted limit" Style="{StaticResource StatusChip}"/>
                    </WrapPanel>
                    <UniformGrid Columns="2">
                        <Button x:Name="extendCylinder_button" Content="Extend" Click="ExtendCylinderButton_Click"
                                Style="{StaticResource SmackButton}" Margin="0,0,4,0"/>
                        <Button x:Name="retractCylinder_button" Content="Retract" Click="RetractCylinderButton_Click"
                                Style="{StaticResource SmackButton}" Margin="4,0,0,0"/>
                    </UniformGrid>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="12,0,0,0" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="End-to-end test" Style="{StaticResource SectionTitle}"/>
                    <!-- Air-test inputs are also three equal, shrinking columns. -->
                    <UniformGrid Columns="3" Margin="0,8,0,0">
                        <StackPanel Margin="0,0,6,5">
                            <TextBlock Text="Cycles" Style="{StaticResource CompactFormLabel}"/>
                            <TextBox x:Name="cycles" Text="0" TextAlignment="Right" Style="{StaticResource SmackTextBox}" MinWidth="0"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,6,5">
                            <TextBlock Text="Settling reads" Style="{StaticResource CompactFormLabel}"/>
                            <TextBox x:Name="settlingReads" Text="0" TextAlignment="Right" Style="{StaticResource SmackTextBox}" MinWidth="0"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,5">
                            <TextBlock Text="Read delay (ms)" Style="{StaticResource CompactFormLabel}"/>
                            <TextBox x:Name="readDelay" Text="0" TextAlignment="Right" Style="{StaticResource SmackTextBox}" MinWidth="0"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,6,5">
                            <TextBlock Text="Extend delay (s)" Style="{StaticResource CompactFormLabel}"/>
                            <TextBox x:Name="extendDelay" Text="0" TextAlignment="Right" Style="{StaticResource SmackTextBox}" MinWidth="0"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,6,5">
                            <TextBlock Text="Retract delay (s)" Style="{StaticResource CompactFormLabel}"/>
                            <TextBox x:Name="retractDelay" Text="0" TextAlignment="Right" Style="{StaticResource SmackTextBox}" MinWidth="0"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,5">
                            <TextBlock Text="Extend timeout (s)" Style="{StaticResource CompactFormLabel}"/>
                            <TextBox x:Name="extendTimeout" Text="0" TextAlignment="Right" Style="{StaticResource SmackTextBox}" MinWidth="0"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,6,5">
                            <TextBlock Text="Retract timeout (s)" Style="{StaticResource CompactFormLabel}"/>
                            <TextBox x:Name="retractTimeout" Text="0" TextAlignment="Right" Style="{StaticResource SmackTextBox}" MinWidth="0"/>
                        </StackPanel>
                    </UniformGrid>
                    <Border Height="1" Background="{StaticResource Smack.Border}" Margin="0,12,0,10"/>
                    <UniformGrid Columns="4">
                        <Button x:Name="pauseTest" Content="Pause" Click="PauseTest_Click"
                                Style="{StaticResource SmackButton}" Margin="0,0,4,0" Padding="5,5" IsEnabled="False"/>
                        <Button x:Name="cancelTest" Content="Cancel" Click="CancelTest_Click"
                                Style="{StaticResource SmackDangerButton}" Margin="0,0,4,0" Padding="5,5" IsEnabled="False"/>
                        <Button x:Name="shutterTestFolderDir_button" Content="Select" ToolTip="Select save directory"
                                Click="SelectTestDirectory_Click" Style="{StaticResource SmackButton}" Margin="0,0,4,0" Padding="5,5"/>
                        <Button x:Name="shutterEnd2End_button" Content="▶ Run" ToolTip="Run end-to-end test"
                                Click="ShutterLimitToLimitTestButton_Click" Style="{StaticResource SmackPrimaryButton}" Padding="5,5"/>
                    </UniformGrid>
                    <WrapPanel Margin="0,10,0,0">
                        <CheckBox x:Name="testPausedCheck" Content="Paused" Style="{StaticResource StatusChip}"/>
                        <CheckBox x:Name="testCancelledCheck" Content="Cancelled" Style="{StaticResource ErrorChip}"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
