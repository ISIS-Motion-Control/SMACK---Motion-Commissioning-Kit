<Window x:Class="TwinCat_Motion_ADS.measurementDeviceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="Measurement device" Height="560" Width="525" MinWidth="470" MinHeight="400"
        Closing="Window_Closing" WindowStartupLocation="CenterScreen"
        Background="{StaticResource Smack.Bg}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Style="{StaticResource Card}" Margin="15">
            <StackPanel>
                <TextBlock Text="Device settings" Style="{StaticResource SectionTitle}" Margin="0,0,0,14"/>
                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="115"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Device name" VerticalAlignment="Center" Foreground="{StaticResource Smack.TextMuted}"/>
                    <TextBox x:Name="deviceName" Grid.Column="1" Style="{StaticResource SmackTextBox}"/>
                </Grid>
                <Grid Margin="0,6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="115"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Device type" VerticalAlignment="Center" Foreground="{StaticResource Smack.TextMuted}"/>
                    <ComboBox x:Name="DeviceTypeComboBox" Grid.Column="1" Style="{StaticResource SmackComboBox}"
                              DropDownClosed="DeviceType_DropDownClosed"/>
                </Grid>
                <Border Height="1" Background="{StaticResource Smack.Border}" Margin="0,12,0,10"/>
                <StackPanel x:Name="deviceSettings"/>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Window>
