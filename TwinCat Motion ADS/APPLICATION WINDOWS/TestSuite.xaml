<Window x:Class="TwinCat_Motion_ADS.TestSuite"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:local="clr-namespace:TwinCat_Motion_ADS"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="Test suite" Width="1030" Height="780" MinWidth="850" MinHeight="540"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing" Background="{StaticResource Smack.Bg}">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="155"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12">
            <TextBlock DockPanel.Dock="Left" Text="Test sequence" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="LoadFileButton" Content="Load" Click="LoadFileButton_Click" Style="{StaticResource SmackButton}" MinWidth="78" Margin="0,0,6,0"/>
                <Button x:Name="SaveFileButton" Content="Save" Click="SaveFileButton_Click" Style="{StaticResource SmackButton}" MinWidth="78" Margin="0,0,6,0"/>
                <Button x:Name="FileSaveSelect" Content="Select save directory" Click="SelectSaveDirectory_Click" Style="{StaticResource SmackButton}"/>
            </StackPanel>
        </DockPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="450"/><ColumnDefinition Width="*" MinWidth="340"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Margin="0,0,7,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <StackPanel x:Name="SettingsPanel" Grid.IsSharedSizeScope="True" Margin="0,0,5,0">
                        <TextBlock Text="Test parameters" Style="{StaticResource SectionTitle}"/>
                        <Grid Margin="0,10,0,5">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Test type" VerticalAlignment="Center" Foreground="{StaticResource Smack.TextMuted}"/>
                            <ComboBox x:Name="SettingTestType" Grid.Column="1" SelectionChanged="SettingTestType_SelectionChanged" Style="{StaticResource SmackComboBox}"/>
                        </Grid>
                        <local:SettingControl x:Name="SettingTitle" SetName="Title" Margin="0,3"/>
                        <local:SettingControl x:Name="SettingAxisNumber" SetName="Axis number" Margin="0,3"/>
                        <local:SettingControl x:Name="SettingCycles" SetName="Cycles" Margin="0,3"/>
                        <local:SettingControl x:Name="SettingCycleDelay" SetName="Cycle delay" Margin="0,3"/>
                        <local:SettingControl x:Name="SettingVelocity" SetName="Velocity" Margin="0,3"/>
                        <local:SettingControl x:Name="SettingTimeout" SetName="Timeout (s)" Margin="0,3"/>
                        <Expander Header="Reversal settings" Style="{StaticResource SmackExpander}" IsExpanded="True">
                            <StackPanel>
                                <local:SettingControl x:Name="SettingReversalVelocity" SetName="Reversal velocity" Margin="0,3"/>
                                <local:SettingControl x:Name="SettingReversalExtraSeconds" SetName="Extra reversal time (s)" Margin="0,3"/>
                                <local:SettingControl x:Name="SettingReversalSettlingSeconds" SetName="Reversal settling (s)" Margin="0,3"/>
                            </StackPanel>
                        </Expander>
                        <Expander Header="Positions and accuracy" Style="{StaticResource SmackExpander}" IsExpanded="True">
                            <StackPanel>
                                <local:SettingControl x:Name="SettingInitialSetpoint" SetName="Initial setpoint" Margin="0,3"/>
                                <local:SettingControl x:Name="SettingEndSetpoint" SetName="End setpoint" Margin="0,3"/>
                                <local:SettingControl x:Name="SettingAccuracySteps" SetName="Steps in test" Margin="0,3"/>
                                <local:SettingControl x:Name="SettingStepSize" SetName="Step size" Margin="0,3"/>
                                <local:SettingControl x:Name="SettingSettlingTime" SetName="Measurement settling (s)" Margin="0,3"/>
                                <local:SettingControl x:Name="SettingReversalDistance" SetName="Reversal distance" Margin="0,3"/>
                                <local:SettingControl x:Name="SettingOvershootDistance" SetName="Overshoot distance" Margin="0,3"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="7,0,0,0">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top" Text="Queued tests" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button x:Name="AddTestButton" Content="Add test" Click="AddTestButton_Click" Style="{StaticResource SmackPrimaryButton}" MinWidth="90"/>
                        <Button x:Name="DeleteTestButton" Content="Delete" Click="DeleteTestButton_Click" Style="{StaticResource SmackDangerButton}" MinWidth="90" Margin="8,0,0,0"/>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions>
                        <ListBox x:Name="TestList" SelectionChanged="TestList_SelectionChanged" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="4,5">
                                        <TextBlock Text="Axis " Foreground="{StaticResource Smack.TextMuted}"/>
                                        <TextBlock Text="{Binding AxisID}" Margin="0,0,14,0"/>
                                        <TextBlock Text="{Binding TestSettings.TestTitle.UiVal}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel x:Name="TestListPanel" Grid.Column="1" VerticalAlignment="Top" Margin="6,0,0,0">
                            <Button x:Name="UpButton" Content="↑" Click="UpButton_Click" Style="{StaticResource SmackButton}" Margin="0,0,0,7" ToolTip="Move selected test up"/>
                            <Button x:Name="DownButton" Content="↓" Click="DownButton_Click" Style="{StaticResource SmackButton}" ToolTip="Move selected test down"/>
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="True">
                    <Button DockPanel.Dock="Right" x:Name="RunTestButton" Content="▶ Run tests" Click="RunTestButton_Click" Style="{StaticResource SmackPrimaryButton}"/>
                    <TextBlock Text="Run status" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                </DockPanel>
                <ListBox x:Name="statusList" FontFamily="{StaticResource Smack.Mono}" FontSize="12"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
