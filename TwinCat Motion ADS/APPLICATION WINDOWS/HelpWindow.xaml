<Window x:Class="TwinCat_Motion_ADS.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="S.M.A.C.K help" Width="1000" Height="670" MinWidth="700" MinHeight="480"
        Background="{StaticResource Smack.Bg}" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="{StaticResource Smack.Surface}" BorderBrush="{StaticResource Smack.Border}" BorderThickness="0,0,1,0">
            <StackPanel Margin="14,18">
                <TextBlock Text="TOPICS" Style="{StaticResource NavHeader}" Margin="10,0,0,8"/>
                <Button x:Name="AxisSetup" Content="Axis setup" Tag="&#xE713;" Style="{StaticResource NavButton}" Click="MenuSelect_Click"/>
                <Button x:Name="EndToEnd" Content="End to end" Tag="&#xE8B7;" Style="{StaticResource NavButton}" Click="MenuSelect_Click"/>
                <Button x:Name="Unidirectional" Content="Unidirectional" Tag="&#xE72A;" Style="{StaticResource NavButton}" Click="MenuSelect_Click"/>
                <Button x:Name="Bidirectional" Content="Bidirectional" Tag="&#xE72B;" Style="{StaticResource NavButton}" Click="MenuSelect_Click"/>
                <Button x:Name="Scaling" Content="Scaling" Tag="&#xE9CE;" Style="{StaticResource NavButton}" Click="MenuSelect_Click"/>
                <Button x:Name="Backlash" Content="Backlash" Tag="&#xE7AD;" Style="{StaticResource NavButton}" Click="MenuSelect_Click"/>
            </StackPanel>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="16">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ContentControl x:Name="helpWindow" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top"/>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
